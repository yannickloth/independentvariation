  "observations": {
    "type": [
      {
        "kind": "enabling",
        "text": "**A typed variable or parameter is checked at the boundary**: `[int]$n` and a typed `param()` block make the binder convert and reject a bad call",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Object-oriented**: Everything is an object (not strings like Bash)",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Classes**: PowerShell 5+ has classes",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Dynamic typing is the default (T1)**: A variable takes its type from the value assigned, so a type error is reported only when the statement runs",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Interfaces**: Can use .NET interfaces",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Module scope pollution**: Import-Module can overwrite commands",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Verb-Noun naming**: While helpful, couples to conventions",
        "mechanism": null
      }
    ],
    "construction": [
      {
        "kind": "enabling",
        "text": "**Constructors**: Classes have constructors, `[PSCustomObject]` for ad-hoc",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Factory patterns**: Common with New-Object cmdlets",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Pipeline objects**: Objects flow through pipelines",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Hashtables**: Often used for construction, less structured",
        "mechanism": null
      },
      {
