  "observations": {
    "type": [
      {
        "kind": "cost",
        "text": "**No type system**: Dynamic, weakly typed",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**TIMTOWTDI**: \"There's More Than One Way To Do It\" creates inconsistency",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Sigils**: `$scalar`, `@array`, `%hash` provide some structure",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Context-sensitive**: Same code behaves differently in scalar/list context",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Moose**: Object system add-on provides types, not core",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**A method call resolves on the run-time object**: `$obj->method` looks the name up in the object's class when the call runs, so a rename breaks a caller only at run time",
        "mechanism": "T3"
      },
      {
        "kind": "cost",
        "text": "**Regular expressions**: Write-only code, couples understanding to expertise",
        "mechanism": null
      }
    ],
    "construction": [
      {
        "kind": "cost",
        "text": "**Bless**: Primitive object system, `bless {}` is manual",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Core class syntax is experimental**: `use feature 'class'` provides a core object system, but the implementation is still experimental, so a project cannot rely on it",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Moose/Moo**: Modern OOP libraries improve this significantly",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Hash-based objects**: No encapsulation enforcement",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Global variables**: `$_`, `@_`, `%ENV` everywhere",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Implicit $_**: Default variable creates hidden dependencies",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Package variables**: Global state pervasive",
        "mechanism": null
      }
    ],
    "memory": [
      {
        "kind": "enabling",
        "text": "**Reference counting**: Deterministic deallocation",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Cyclic references**: Leak unless broken manually",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Automatic**: No manual malloc/free",
        "mechanism": null
      }
    ],
    "error": [
      {
        "kind": "cost",
        "text": "**Die/eval**: Exceptions not typed, `eval` catches everything",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Return undef**: Many functions return `undef` on error, silent failures",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**$!**: Global error variable couples error state",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Signatures declare parameters only**: A sub's signature does not state the errors it may raise, so the failure channel is invisible at the call",
        "mechanism": null
      }
    ],
    "concurrency": [
      {
        "kind": "caution",
        "text": "**Threads**: Available but discouraged, heavyweight",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Fork**: Process-based concurrency common",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**No modern concurrency**: No async/await, no actors",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Shared state**: Manual locking, error-prone",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**A thread is an interpreter thread**: Each one reserves an operating-system thread, so the program pays per task",
        "mechanism": "K6"
      }
    ],
    "platform": [
      {
