  "observations": {
    "type": [
      {
        "kind": "cost",
        "text": "**No static types**: All coupling deferred to runtime",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Prototypes decouple**: Can modify behavior without inheritance",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Duck typing**: Structural at runtime, but no safety",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Type coercion couples**: Implicit conversions hide intent",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Undefined/null confusion**: Two absence types couple",
        "mechanism": null
      }
    ],
    "construction": [
      {
        "kind": "enabling",
        "text": "**Object literals**: Simple construction without classes",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Prototypes flexible**: Can change after construction",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**`new` keyword confusing**: `this` binding couples to call context",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Factory functions decouple**: Can avoid `new` entirely",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Global scope couples**: `window`, `globalThis` everywhere",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Module side effects**: Import order matters",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Prototype pollution**: Can modify built-in prototypes globally",
        "mechanism": null
      }
    ],
    "memory": [
      {
        "kind": "enabling",
        "text": "**Garbage collection decouples memory**: Generational GC (implementation dependent)",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**No manual memory management**: Can't have use-after-free",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**GC pauses affect latency**: V8, SpiderMonkey, etc. have different characteristics",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Closure captures create leaks**: Easy to accidentally hold references",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Event listener leaks common**: Forgotten listeners prevent collection",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Reference cycles are collected**: A mark-and-sweep collector reclaims objects that point at each other, so a cycle alone is not a leak",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**WeakMap/WeakRef help**: Can create weak references, but not automatic",
        "mechanism": null
      }
    ],
    "error": [
      {
        "kind": "cost",
        "text": "**Exceptions unchecked**: No type tracking",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Promise rejection unchecked**: `.catch()` optional",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Result types possible**: Libraries exist but uncommon",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Callbacks couple error/success**: `(err, result)` mixes concerns",
        "mechanism": null
      }
    ],
    "concurrency": [
      {
        "kind": "cost",
        "text": "**Single-threaded event loop**: A long task blocks every other callback, so no second core is available for CPU-bound work",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Async/await separates**: Explicit async functions",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Promise errors untracked**: Rejection type unknown",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Web Workers separate**: Explicit message passing, but manual",
        "mechanism": null
      }
    ],
    "platform": [
      {
        "kind": "enabling",
        "text": "**No vendor owns the language**: ECMAScript is standardized by Ecma International as ECMA-262 and evolves through the public TC39 proposal process",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Independent engines implement it**: V8, SpiderMonkey, and JavaScriptCore are separate implementations, so a program is not bound to one vendor's runtime",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**A runtime exists on every platform**: Every web browser ships an engine, and Node.js, Deno, and Bun run the language outside the browser",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**The source is portable between hosts**: The same script runs in a browser and in Node.js; only the host API differs, not the language",
        "mechanism": null
      }
    ],
    "performance": [
      {
