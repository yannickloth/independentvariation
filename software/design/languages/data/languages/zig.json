  "observations": {
    "type": [
      {
        "kind": "enabling",
        "text": "**No hidden control flow**: Everything explicit, no operator overloading coupling",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Comptime metaprogramming**: Type-level computation decouples patterns from instances",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Tagged unions**: Discriminated unions like Rust enums",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**No interfaces yet**: Manual duck typing",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Comptime can be complex**: Metaprogramming couples to compile-time semantics",
        "mechanism": null
      }
    ],
    "construction": [
      {
        "kind": "enabling",
        "text": "**Explicit allocation**: Separate allocator parameter, decouples memory strategy",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**No constructors**: Just functions, like Go",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Zero is sensible**: Default values are predictable",
        "mechanism": null
      }
    ],
    "memory": [
      {
        "kind": "enabling",
        "text": "**Allocator-as-parameter decouples perfectly**: Every allocation takes explicit allocator",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Manual control**: malloc/free style, predictable",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**No hidden allocations**: Compiler never allocates without explicit allocator",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**No safety**: Use-after-free, double-free possible (but less common than C)",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Defer for cleanup**: `defer free(ptr)` couples cleanup to scope, predictable",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**No GC pauses**: Deterministic performance",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Error unions complicate lifetimes**: Returning errors can extend memory lifetimes",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Comptime allocation separate**: Compile-time vs runtime allocation explicit",
        "mechanism": null
      }
    ],
    "error": [
