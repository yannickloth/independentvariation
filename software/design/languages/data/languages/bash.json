  "observations": {
    "type": [
      {
        "kind": "cost",
        "text": "**Everything is strings**: No type system whatsoever",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**No abstractions**: Shell functions are commands with positional parameters, and there are no interfaces",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Associative arrays**: Bash 4+ has hashes, but limited",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**No encapsulation**: All variables global unless explicitly local",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**No modules**: Sourcing scripts pollutes namespace",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Word splitting**: Unquoted variables couple to IFS",
        "mechanism": null
      }
    ],
    "construction": [
      {
        "kind": "cost",
        "text": "**No objects**: Not an object-oriented language",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**No constructors**: Everything is imperative scripting",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Functions**: Can simulate construction with functions",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**No validation**: Can't enforce invariants",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Global variables**: All variables global unless `local`",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Environment variables**: Implicit dependencies everywhere",
        "mechanism": null
      }
    ],
    "memory": [
      {
        "kind": "enabling",
        "text": "**Automatic**: Shell manages memory for variables",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Process-based**: Each script is a process, cleaned up on exit",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**File descriptors**: Must manually close, can leak",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**No manual management**: Can't segfault (unless calling C programs)",
        "mechanism": null
      }
    ],
    "error": [
      {
        "kind": "cost",
        "text": "**Exit codes only**: Return 0-255, no typed errors",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Ignores errors by default**: Must use `set -e` to fail on errors, and a failure is otherwise silent",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**No exceptions**: Can't catch/throw",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**`trap`**: Can handle signals, but limited",
        "mechanism": null
      }
    ],
    "concurrency": [
      {
        "kind": "caution",
        "text": "**Background jobs**: `&` runs in background",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**No coordination**: No semaphores, mutexes in pure bash",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Pipes**: Pipeline concurrency, but limited",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Race conditions**: Easy to create, hard to avoid",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Process-based**: Fork/exec model, heavyweight",
        "mechanism": null
      }
    ],
    "platform": [
      {
        "kind": "cost",
        "text": "**Path dependencies**: Couples to external commands availability",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Platform coupling**: Bash version, coreutils differences",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**A POSIX subset is portable across systems**: A script limited to POSIX `sh` runs under dash, ash, ksh, and zsh, and the standard is a published specification",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**The script is the artifact**: A Bash program is a text file that needs only an interpreter on the target, so nothing of the language is deployed with it",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**The shell is a GNU project with no vendor owner**: Bash is developed in the open by the GNU Project under the GPL",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**The dialect is defined by one implementation**: The extensions beyond POSIX (`[[ ]]`, arrays, `local`, `mapfile`) are Bash's own, so a script that uses them depends on Bash and its version",
        "mechanism": "P2"
      },
      {
        "kind": "caution",
        "text": "**The installed Bash version varies by platform**: MacOS ships Bash 3.2 while Linux distributions ship Bash 5.x, so a script that uses newer features fails on the older interpreter",
        "mechanism": null
      }
    ],
    "performance": [
      {
        "kind": "cost",
        "text": "**Very slow**: Interprets every line, with no JIT and no compilation",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Process spawning**: Fork/exec for every command",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**String manipulation**: Terribly inefficient",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Good for orchestration**: Fast when calling other programs",
        "mechanism": null
      }
    ],
    "ecosystem": [
      {
        "kind": "enabling",
        "text": "**Ubiquitous**: On every Unix system",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**No package manager**: Manual dependency management",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**shellcheck**: Excellent linter",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**No IDE support**: Basic syntax highlighting only",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Coreutils**: Standard Unix tools available",
        "mechanism": null
      }
    ],
    "evolution": [
      {
        "kind": "enabling",
        "text": "**Stable**: Bash 3/4/5 mostly compatible",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Slow evolution**: Conservative changes",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Fragmentation**: Sh, bash, zsh, fish differ",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**POSIX**: Standard helps portability",
        "mechanism": null
      }
    ],
    "domain": [
      {
        "kind": "enabling",
        "text": "**Excellent for shell automation**: Perfect use case",
        "mechanism": null
      },
      {
        "kind": "enabling",
