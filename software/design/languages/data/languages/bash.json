    ],
    "learning": [
      {
        "kind": "enabling",
        "text": "**Easy to start**: Simple commands work",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Hard to master**: Quoting, word splitting, and unquoted variables are footguns",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Good resources**: Advanced Bash Scripting Guide",
        "mechanism": null
      }
    ],
    "syntax": [
      {
        "kind": "cost",
        "text": "**Quirky**: `[` vs `[[`, quoting rules",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Verbose**: `if [ \"$x\" = \"y\" ]; then`",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Pipe-oriented**: Natural for Unix philosophy",
        "mechanism": null
      },
      {
