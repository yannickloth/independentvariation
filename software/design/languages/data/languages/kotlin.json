  "observations": {
    "type": [
      {
        "kind": "enabling",
        "text": "**Null safety separates nullable from non-nullable**: `String` vs `String?` is explicit",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Extension functions decouple**: Add methods without inheritance",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Sealed classes separate cases**: Exhaustive when expressions",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Inline functions decouple abstraction cost**: Zero-cost abstractions like Rust",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Generics erase on the JVM**: `List<String>` is a `List` at run time, so a cast or a reflective call can reach a type the declaration does not admit",
        "mechanism": "T7"
      },
      {
        "kind": "cost",
        "text": "**Java interop allows nulls**: Calling Java code bypasses null safety",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Inheritance still available**: Can create coupled hierarchies",
        "mechanism": null
      }
    ],
    "construction": [
