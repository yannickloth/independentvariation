  "observations": {
    "type": [
      {
        "kind": "enabling",
        "text": "**Distinct types**: Create new types from existing without coupling",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Concepts**: Generic constraints like Rust traits",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Method call syntax**: Uniform function call, decouples OOP from functional style",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Macros powerful but complex**: Can create coupling in generated code, and can hide it behind opaque expansion",
        "mechanism": null
      }
    ],
    "construction": [
      {
        "kind": "enabling",
        "text": "**Objects, tuples, refs separate**: Multiple data representation strategies",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**GC for refs**: Garbage collection couples to runtime",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Destructors for non-GC**: Can manage resources explicitly",
        "mechanism": null
      }
    ],
    "memory": [
      {
        "kind": "caution",
        "text": "**Multiple GC modes**: Can choose GC strategy (ARC, Boehm, etc.)",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Ref vs value types**: Can choose between GC (ref) and stack (value)",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**GC pauses affect latency**: Depends on the GC mode, so allocation timing cannot be controlled precisely",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Destructors for deterministic cleanup**: `=destroy` hook for custom cleanup",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**ARC mode has cycles**: Automatic reference counting needs manual cycle breaking",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**No GC mode available**: Can compile without GC for embedded",
        "mechanism": null
      },
      {
