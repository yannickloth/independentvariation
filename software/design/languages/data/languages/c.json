  "observations": {
    "type": [
      {
        "kind": "enabling",
        "text": "**Structs separate data**: Pure data, no methods",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Function pointers enable polymorphism**: Can pass behavior as data",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**No encapsulation**: Everything is public",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**No generics**: Void pointers couple to type casting",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**No inheritance**: Can't create coupled hierarchies",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Header files couple**: Includes create compilation dependencies",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Macros couple**: Preprocessor doesn't respect scope",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**No namespaces**: Global namespace pollution",
        "mechanism": null
      }
    ],
    "construction": [
      {
        "kind": "enabling",
        "text": "**Explicit memory management**: Allocation separate from initialization",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Designated initializers**: Can initialize specific fields",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**No constructors**: Manual initialization couples to usage",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Global state common**: Static variables couple modules",
        "mechanism": null
      }
    ],
    "memory": [
      {
        "kind": "enabling",
        "text": "**Manual control enables precise memory strategy**: Can separate memory management from logic",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Explicit allocation/deallocation**: malloc/free make lifetime visible",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**No safety**: Use-after-free, double-free, memory leaks all possible",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**No RAII**: Must manually track and free resources",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Predictable**: No GC pauses, deterministic performance",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Pointer arithmetic couples to memory layout**: Buffer overruns couple to hardware, with no abstraction over memory",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Custom allocators**: Can decouple allocation strategy (arena, pool, etc.)",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Undefined behavior on errors**: Buffer overruns, null derefs, and other memory-safety violations are UB",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Storage arrives uninitialized**: reading an automatic object before initialization is undefined behaviour, and malloc returns bytes nobody wrote, so every read depends on a write the code must prove happened on every path",
        "mechanism": "M5"
      },
      {
        "kind": "cost",
        "text": "**Bytes can be read as a type they never were**: a union member, a pointer cast, or a `char*` read reinterprets storage with no check, and only the effective-type rule separates the honest puns from the undefined ones",
        "mechanism": "M6"
      }
    ],
    "error": [
      {
        "kind": "enabling",
        "text": "**Explicit error codes**: Return values make errors visible",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**No enforcement**: Can ignore return values",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**errno couples**: Global error state couples functions",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**NULL everywhere**: Pointer errors couple all code",
        "mechanism": null
      }
    ],
    "concurrency": [
      {
        "kind": "cost",
        "text": "**pthreads manual**: All synchronization explicit",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Shared mutable state default**: No protection",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Data races are undefined behavior**: No prevention",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Explicit is predictable**: At least coupling is visible",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**A thread is an operating-system thread**: `pthread_create` reserves one for the task's whole life, and a blocked task holds it",
        "mechanism": "K6"
      }
    ],
    "platform": [
      {
        "kind": "enabling",
        "text": "**No platform owner**: The language is standardised by ISO/IEC and implemented independently by GCC, Clang, and MSVC, so no single vendor controls it",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**No required platform runtime**: A conforming program depends only on the C standard library, not on a vendor runtime",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Every mainstream platform has a C compiler**: Linux, macOS, Windows, and embedded targets all have conforming implementations, and operating systems expose a C ABI to other languages",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**No single-implementation dependence**: Source compiles under more than one compiler, so the loss of one implementation does not strand the code",
        "mechanism": null
      }
    ],
    "performance": [
