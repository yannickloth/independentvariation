  "observations": {
    "type": [
      {
        "kind": "enabling",
        "text": "**Protocols decouple interface from implementation**: Similar to Rust traits",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Value types (structs) vs reference types (classes)**: Explicit separation",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Enums with associated values**: Discriminated unions like Rust/F#",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Generics with constraints**: `<T: Equatable>` decouples from concrete types",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Optional chaining**: `?.` syntax elegant but can hide nil propagation",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**AnyObject/Any**: Type erasure creates coupling escape hatch",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Force unwrap (`!`)**: Bypasses type safety, couples to runtime crashes",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Implicitly unwrapped optionals**: `String!` hides nil possibility",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Dynamic dispatch overhead**: Protocol witness tables couple performance",
        "mechanism": null
      }
    ],
    "construction": [
      {
        "kind": "enabling",
        "text": "**Initializers separate from usage**: `init` methods decouple construction",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Failable initializers**: `init?` makes construction failure explicit",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Value semantics by default**: Structs copy, preventing shared state coupling",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Classes allow inheritance**: Can create coupling hierarchies",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Protocol-oriented programming**: Composition over inheritance",
        "mechanism": null
      }
    ],
    "memory": [
      {
        "kind": "enabling",
        "text": "**Automatic Reference Counting (ARC)**: Deterministic, no GC pauses",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Retain cycles possible**: Weak/unowned references needed for graphs",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Value types**: No reference counting for structs",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Predictable**: Deallocation timing known",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**Objective-C interop**: Foreign code can introduce manual memory management and can bypass Swift's safety guarantees",
        "mechanism": null
      }
    ],
    "error": [
      {
        "kind": "enabling",
        "text": "**Typed throws (Swift 6)**: `throws(MyError)` makes error types explicit in signatures — a major coupling improvement over untyped `throws`",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Do-try-catch**: Explicit error handling, checked at call site",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**`Result<T, E>` available**: For functional-style composable error handling",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Failable initializers**: `init?` returns nil instead of throwing",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Force unwrap**: `!` bypasses safety, couples to runtime crash",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Guard statements**: Early exit decouples validation from logic",
        "mechanism": null
      }
    ],
    "concurrency": [
      {
        "kind": "enabling",
        "text": "**Swift Concurrency (async/await)**: Built-in, structured concurrency",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Actors**: Data race prevention via isolation",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Sendable protocol + strict concurrency checking (Swift 6, on by default)**: Compile-time thread safety with full enforcement",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Task-based**: Decouples concurrent operations",
        "mechanism": null
      },
      {
        "kind": "caution",
        "text": "**Grand Central Dispatch (GCD)**: Legacy API still available, manual",
        "mechanism": null
      }
    ],
    "platform": [
      {
        "kind": "enabling",
        "text": "**The toolchain is open source**: The Swift compiler, standard library, and Swift Package Manager are developed in the open at github.com/swiftlang under the Apache 2.0 licence",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**The language runs outside Apple platforms**: Official Linux toolchains cover Ubuntu, Fedora, and Amazon Linux, and a Windows toolchain is distributed alongside macOS",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**The package manager is platform-independent**: SwiftPM resolves one manifest and builds the same targets on macOS, Linux, and Windows",
        "mechanism": null
      },
      {
        "kind": "enabling",
        "text": "**Server-side frameworks run on Linux**: Vapor and Hummingbird target the Linux toolchain, so a non-Apple deployment does not need Apple hardware",
        "mechanism": null
      },
      {
        "kind": "cost",
        "text": "**One vendor sets the language direction**: Apple owns the evolution process and ships the complete toolchain in Xcode, so the platform a project depends on has a single centre",
        "mechanism": "P2"
      },
      {
        "kind": "caution",
        "text": "**The strongest tools are Apple-only**: Instruments and the Xcode debugger have no full equivalent on Linux, so profiling and debugging off Apple platforms are weaker",
        "mechanism": null
      }
